# Copiar a .env. No publicar .env ni la carpeta de datos.
HOST=127.0.0.1
PORT=4173
NODE_ENV=development
PUBLIC_URL=http://127.0.0.1:4173
DATA_DIR=.runtime
# En revisión local, los correos se guardan en .runtime/outbox (no se envían).
# En producción son obligatorios HTTPS, contacto y proveedor de correo configurado.
RESEND_API_KEY=
MAIL_FROM=
CONTACT_EMAIL=
